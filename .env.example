# Copy to .env (gitignored), fill in real values, then load:
#   set -a; . ./.env; set +a
#
# These are PLACEHOLDERS. Never commit the real .env.

# Source: Azure Blob account key (or use a SAS / delegation token instead)
SRC_AZURE_ACCOUNT_KEY="REPLACE_ME"

# Destination: S3-compatible access key and secret key
DST_S3_ACCESS_KEY="REPLACE_ME"
DST_S3_SECRET_KEY="REPLACE_ME"
